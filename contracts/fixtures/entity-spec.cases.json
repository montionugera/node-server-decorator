    {
      "name": "ops-list-only-emits-no-other-routes",
      "spec": {
        "specVersion": "1.2.0",
        "entity": "Widget",
        "path": "widgets",
        "transports": [
          "rest"
        ],
        "ops": [
          "list"
        ],
        "pagination": "offset",
        "fields": [
          {
            "name": "id",
            "type": "str",
            "role": "id",
            "readonly": true
          }
        ]
      },
      "expect": {
        "/paths/~1widgets/get/operationId": "listWidget",
        "/paths/~1widgets/post": null,
        "/paths/~1widgets~1{id}": null
      }
    },
