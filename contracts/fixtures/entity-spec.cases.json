    {
      "name": "apikey-scheme-maps-in-and-paramName",
      "spec": {
        "specVersion": "1.2.0",
        "entity": "Key",
        "path": "keys",
        "transports": [
          "rest"
        ],
        "ops": [
          "create"
        ],
        "pagination": "offset",
        "fields": [
          {
            "name": "id",
            "type": "str",
            "role": "id",
            "readonly": true
          },
          {
            "name": "label",
            "type": "str"
          }
        ],
        "security": {
          "schemes": [
            {
              "name": "apiKeyAuth",
              "type": "apiKey",
              "in": "header",
              "paramName": "X-API-Key"
            }
          ],
          "ops": {
            "create": [
              "key:write"
            ]
          }
        }
      },
      "expect": {
        "/components/securitySchemes/apiKeyAuth": {
          "type": "apiKey",
          "in": "header",
          "name": "X-API-Key"
        },
        "/paths/~1keys/post/security/0/apiKeyAuth/0": "key:write"
      }
    },
    {
      "name": "409-only-on-an-action-declaring-a-from-state",
      "spec": {
        "specVersion": "1.2.0",
        "entity": "Job",
        "path": "jobs",
        "transports": [
          "rest"
        ],
        "ops": [
          "get"
        ],
        "pagination": "offset",
        "fields": [
          {
            "name": "id",
            "type": "str",
            "role": "id",
            "readonly": true
          },
          {
            "name": "status",
            "type": "enum",
            "enum": [
              "queued",
              "running"
            ]
          }
        ],
        "actions": [
          {
            "name": "start",
            "stateField": "status",
            "from": "queued",
            "to": "running"
          },
          {
            "name": "ping"
          }
        ]
      },
      "expect": {
        "/paths/~1jobs~1{id}~1actions~1start/post/responses/409/description": "Conflict",
        "/paths/~1jobs~1{id}~1actions~1ping/post/responses/409": null,
        "/components/schemas/JobPingInput": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      }
    },
    {
      "name": "nullable-inside-a-nested-obj-renders-a-type-array",
      "spec": {
        "specVersion": "1.2.0",
        "entity": "Profile",
        "path": "profiles",
        "transports": [
          "rest"
        ],
        "ops": [
          "get"
        ],
        "pagination": "offset",
        "fields": [
          {
            "name": "id",
            "type": "str",
            "role": "id",
            "readonly": true
          },
          {
            "name": "meta",
            "type": "obj",
            "fields": [
              {
                "name": "note",
                "type": "str",
                "nullable": true
              }
            ]
          }
        ]
      },
      "expect": {
        "/components/schemas/ProfileRead/properties/meta/properties/note/type": [
          "string",
          "null"
        ],
        "/components/schemas/ProfileRead/properties/meta/additionalProperties": false
      }
    },
    {
      "name": "include-rule-recurses-into-nested-obj-and-list-items",
      "spec": {
        "specVersion": "1.2.0",
        "entity": "Order",
        "path": "orders",
        "transports": [
          "rest"
        ],
        "ops": [
          "create"
        ],
        "pagination": "offset",
        "fields": [
          {
            "name": "id",
            "type": "str",
            "role": "id",
            "readonly": true
          },
          {
            "name": "meta",
            "type": "obj",
            "fields": [
              {
                "name": "createdBy",
                "type": "str",
                "readonly": true
              },
              {
                "name": "note",
                "type": "str"
              }
            ]
          },
          {
            "name": "lines",
            "type": "list",
            "item": {
              "name": "lines",
              "type": "obj",
              "fields": [
                {
                  "name": "sku",
                  "type": "str"
                },
                {
                  "name": "computedTotal",
                  "type": "float",
                  "readonly": true
                }
              ]
            }
          }
        ]
      },
      "expect": {
        "/components/schemas/OrderCreate/properties/meta/properties/note/type": "string",
        "/components/schemas/OrderCreate/properties/meta/properties/createdBy": null,
        "/components/schemas/OrderCreate/properties/meta/required": [
          "note"
        ],
        "/components/schemas/OrderCreate/properties/lines/items/properties/sku/type": "string",
        "/components/schemas/OrderCreate/properties/lines/items/properties/computedTotal": null,
        "/components/schemas/OrderCreate/properties/lines/items/required": [
          "sku"
        ],
        "/components/schemas/OrderRead/properties/meta/properties/createdBy/type": "string",
        "/components/schemas/OrderRead/properties/lines/items/properties/computedTotal/type": "number"
      }
    }
