{
  "name": "@montionugera/entity-spec",
  "version": "2.0.7",
  "description": "Declarative entity decorators emitting the language-neutral EntitySpec IR (contracts/schemas/entity-spec.schema.json).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "testing": [
        "dist/testing/user-fixture.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/user-fixture.d.ts",
      "default": "./dist/testing/user-fixture.js"
    }
  },
  "files": [
    "dist/"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:unit": "jest",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm test:unit && pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-username/server-decorator.git",
    "directory": "node/packages/entity"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.16.5",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.14.2"
}
