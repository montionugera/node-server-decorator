.npmrc
dist
node_modules
.astro


# GitHub Actions
.env
*.log

# Package managers
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json  # Use pnpm-lock.yaml instead
yarn.lock         # Use pnpm-lock.yaml instead
# uv is dev-only; do not commit the lockfile
python/uv.lock

# iCloud-style duplicate files (D-D)
* 2
* 2.*
* 3
* 3.*

# Python (added during polyglot migration)
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
# ps-release-workflow (gitignored state)
.claude/state/
.claude/worktrees/

# Rendered design HTML — local view artifacts only (global rule)
docs/superpowers/**/*.html
research/**/*.html

# Nim (F-006): `nim c` drops binaries beside sources; `nim r`/`nimble test` do not, but be safe.
nimcache/
nim/tests/t_*
!nim/tests/t_*.nim
nim/examples/emit_*
!nim/examples/emit_*.nim
nim/examples/user
nim/nimble.lock
# ^ the package has zero dependencies (plan constraint) — this lockfile must never be committed.

# graft's local graph cache — regenerable, not committed (run `graft build`).
graft/
# Rust build artifacts
target/
rust/target/

